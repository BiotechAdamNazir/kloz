KN.am", "y": "T"}, {"t": "Farid", "k": "KN.khas", "y": "T"}], "lens": [{"a": 0, "b": 0, "l": "pw", "alt": ["Tajuk"], "o": "Struktur (kepala e-mel): baris ini menyatakan perkara atau tajuk e-mel dalam beberapa patah perkataan."}, {"a": 5, "b": 5, "l": "pw", "alt": ["Helo", "Salam"], "o": "Struktur (salam pembuka): e-mel tidak rasmi kepada kawan bermula dengan salam mesra, kemudian nama kawan."}, {"a": 8, "b": 8, "l": "pw", "alt": [], "o": "Struktur (pembuka): bertanya khabar ialah soalan mesra selepas salam."}, {"a": 10, "b": 10, "l": "pw", "alt": ["berharap"], "o": "Struktur (pembuka): selepas bertanya khabar, nyatakan harapan supaya kawan sihat."}, {"a": 16, "b": 16, "l": "tb", "alt": [], "o": "Struktur (pembuka): ucapkan terima kasih atas e-mel kawan. Sebelum kata nama, guna 'terima kasih atas'."}, {"a": 37, "b": 37, "l": "kt", "alt": ["menghadapi"], "o": "Mengalami = merasai atau melalui sesuatu keadaan."}, {"a": 46, "b": 46, "l": "pw", "alt": ["menceritakan"], "o": "Struktur (tujuan): ayat ini menyatakan sebab anda menulis e-mel. Berkongsi pengalaman = menceritakan pengalaman kepada orang lain."}, {"a": 49, "b": 49, "l": "pw", "alt": ["Dulu", "Sebelum ini"], "o": "Struktur (isi 1): perenggan baharu bermula dengan penanda masa. Perkataan ini bermaksud pada masa yang lepas."}, {"a": 59, "b": 59, "l": "kt", "alt": ["tidak"], "o": "Jarang = tidak selalu. Ini salah satu tabiat buruk: tidak makan sarapan."}, {"a": 66, "b": 66, "l": "pw", "alt": ["Jadi", "Oleh sebab itu", "Kesannya"], "o": "Penanda wacana sebab dan akibat: memperkenalkan kesan buruk tabiat tadi."}, {"a": 69, "b": 69, "l": "kt", "alt": [], "o": "Mengantuk = berasa mahu tidur."}, {"a": 76, "b": 76, "l": "pw", "alt": ["Kini"], "o": "Struktur (isi 2): penanda masa yang berlawanan dengan masa lepas. Perenggan baharu, idea baharu."}, {"a": 79, "b": 79, "l": "kt", "alt": ["menukar"], "o": "Mengubah tabiat = menjadikan tabiat itu berlainan daripada dahulu."}, {"a": 82, "b": 82, "l": "pw", "alt": ["Pertama sekali"], "o": "Penanda wacana urutan: menyenaraikan perubahan satu demi satu."}, {"a": 92, "b": 92, "l": "kt", "alt": [], "o": "Kata kerja ini bermaksud mengambil B sebagai ganti A."}, {"a": 95, "b": 95, "l": "tb", "alt": [], "o": "Kata sendi yang berpasangan dengan 'menggantikan' (menggantikan A ___ B)."}, {"a": 98, "b": 98, "l": "pw", "alt": ["Selain itu", "Seterusnya"], "o": "Penanda wacana urutan: perubahan yang seterusnya dalam senarai."}, {"a": 125, "b": 125, "l": "pw", "alt": ["Kesannya"], "o": "Struktur (isi 3): penanda wacana hasil, memperkenalkan kesan baik daripada perubahan itu."}, {"a": 129, "b": 129, "l": "kt", "alt": ["cergas", "segar", "sihat"], "o": "Bermaksud mempunyai banyak tenaga, tidak letih."}, {"a": 134, "b": 134, "l": "kt", "alt": ["perhatian"], "o": "Bermaksud memusatkan fikiran kepada sesuatu."}, {"a": 153, "b": 153, "l": "pw", "alt": ["Oleh sebab itu", "Oleh yang demikian", "Jadi", "Justeru"], "o": "Struktur (cadangan): penanda wacana yang membawa kepada nasihat anda untuk kawan."}, {"a": 155, "b": 155, "l": "kt", "alt": ["menyarankan"], "o": "Mencadangkan = memberikan idea atau nasihat kepada seseorang."}, {"a": 166, "b": 166, "l": "kt", "alt": ["meletakkan"], "o": "Menyimpan = meletakkan sesuatu di sesuatu tempat."}, {"a": 197, "b": 197, "l": "pb", "alt": ["terluang", "senggang"], "o": "Masa lapang = masa ketika kita tidak sibuk."}, {"a": 183, "b": 183, "l": "pw", "alt": [], "o": "Struktur (penutup): ayat ini menandakan e-mel hampir tamat."}, {"a": 190, "b": 190, "l": "pw", "alt": ["Balas"], "o": "Struktur (penutup): minta kawan membalas e-mel. Akhiran -lah menjadikan permintaan lebih lembut."}, {"a": 198, "b": 198, "l": "pw", "alt": ["Kawanmu", "Rakanmu", "Temanmu", "Yang ikhlas"], "o": "Struktur (tandatangan): e-mel tidak rasmi ditutup dengan kata mesra, kemudian nama anda. 'Yang benar' hanya untuk surat rasmi; 'Yang ikhlas' juga sesuai untuk kawan."}]}